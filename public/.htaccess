# ZOAC — zambianadventures.com on Verpex (LiteSpeed/Apache)
# Turn on AutoSSL in cPanel BEFORE the first deploy: this file forces HTTPS.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/svg+xml .svg
AddType video/mp4 .mp4

# ---------- one canonical address: https://zambianadventures.com ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # zambianoutdoors.com (park it / add it as an alias domain on this account) → primary domain
  RewriteCond %{HTTP_HOST} ^(www\.)?zambianoutdoors\.com$ [NC]
  RewriteRule ^ https://zambianadventures.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://zambianadventures.com%{REQUEST_URI} [L,R=301]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]
</IfModule>

# ---------- compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Next.js hashes everything under /_next/static, so it can be cached forever.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Keep enquiry data and dotfiles private.
<FilesMatch "^(\.|enquiries\.csv$)">
  Require all denied
</FilesMatch>
